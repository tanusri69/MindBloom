<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindbloom.ui.AnalyticsController">

    <!-- Top: Controls -->
    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <Label text="Mood Analytics & Trends"
                   style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Button fx:id="weeklyTrendButton" text="📊 Weekly Trend" prefWidth="130"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
                <Button fx:id="monthlyTrendButton" text="📈 Monthly Trend" prefWidth="130"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
                <Button fx:id="moodFreqButton" text="📉 Mood Frequency" prefWidth="130"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
                <Button fx:id="bestWeekButton" text="🏆 Best Week" prefWidth="100"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Charts and Stats Display -->
    <center>
        <VBox spacing="10" style="-fx-padding: 15;">
            <TextArea fx:id="chartArea" wrapText="true" editable="false"
                      prefHeight="500" style="-fx-font-family: monospace; -fx-font-size: 11;
                      -fx-control-inner-background: #f8f9fa;"/>
        </VBox>
    </center>

    <!-- Bottom: Status -->
    <bottom>
        <HBox style="-fx-padding: 10; -fx-background-color: #ecf0f1;">
            <Label fx:id="statusLabel" text="Ready"
                   style="-fx-text-fill: #34495e;"/>
        </HBox>
    </bottom>

</BorderPane>
