<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindbloom.ui.RemindersController">

    <!-- Top: Controls -->
    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <Label text="Habit Reminders & Stress Check"
                   style="-fx-font-size: 14; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Button fx:id="pendingHabitsButton" text="📋 Pending Habits" prefWidth="130"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
                <Button fx:id="stressCheckButton" text="⚠️ Stress Check" prefWidth="130"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
                <Button fx:id="snoozeSettingsButton" text="🔇 Snooze Settings" prefWidth="130"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
                <Button fx:id="refreshButton" text="🔄 Refresh" prefWidth="100"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Reminders Display -->
    <center>
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label text="Reminder Status"
                   style="-fx-font-size: 12; -fx-font-weight: bold;"/>
            <TextArea fx:id="remindersArea" wrapText="true" editable="false"
                      prefHeight="400" style="-fx-font-family: monospace; -fx-font-size: 11;
                      -fx-control-inner-background: #f8f9fa;"/>
        </VBox>
    </center>

    <!-- Bottom: Status -->
    <bottom>
        <HBox style="-fx-padding: 10; -fx-background-color: #ecf0f1;">
            <Label fx:id="statusLabel" text="Ready"
                   style="-fx-text-fill: #34495e;"/>
        </HBox>
    </bottom>

</BorderPane>
