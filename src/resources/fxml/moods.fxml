<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindbloom.ui.MoodsController">

    <!-- Top: Input Section -->
    <top>
        <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">
            <Label text="Add New Mood Entry"
                   style="-fx-font-size: 14; -fx-font-weight: bold;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Mood:" style="-fx-min-width: 50;"/>
                <ComboBox fx:id="moodComboBox" prefWidth="150"
                          promptText="Select or type mood"/>
                <Label text="Note:" style="-fx-min-width: 40;"/>
                <TextField fx:id="noteTextField" prefWidth="300"
                           promptText="Optional note about your mood"/>
            </HBox>

            <HBox spacing="10">
                <Button fx:id="addMoodButton" text="➕ Add Mood" prefWidth="120"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
                <Button fx:id="refreshButton" text="🔄 Refresh" prefWidth="100"
                        style="-fx-font-size: 11; -fx-padding: 8;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Mood History Table -->
    <center>
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label text="Mood History"
                   style="-fx-font-size: 13; -fx-font-weight: bold;"/>
            <TableView fx:id="moodHistoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Date" prefWidth="100" fx:id="dateColumn"/>
                    <TableColumn text="Mood" prefWidth="100" fx:id="moodColumn"/>
                    <TableColumn text="Note" prefWidth="400" fx:id="noteColumn"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom: Status -->
    <bottom>
        <HBox style="-fx-padding: 10; -fx-background-color: #ecf0f1;">
            <Label fx:id="statusLabel" text="Ready"
                   style="-fx-text-fill: #34495e;"/>
        </HBox>
    </bottom>

</BorderPane>
