<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mindbloom.ui.MainWindowController"
            prefWidth="1000" prefHeight="700"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11;">

    <!-- Top Menu Bar -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label text="🌱 MindBloom - Mental Health &amp; Habit Tracker"
                   style="-fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Center: Tabbed Interface -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;">

            <!-- Dashboard Tab -->
            <Tab text="📊 Dashboard" fx:id="dashboardTab" closable="false">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <Label text="Welcome to MindBloom! 🌱" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
                    <Label text="Track your mood, build better habits, and improve your mental health." style="-fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- Moods Tab -->
            <Tab text="😊 Moods" fx:id="moodsTab" closable="false">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Moods" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label text="Mood management features coming soon" style="-fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- Habits Tab -->
            <Tab text="✅ Habits" fx:id="habitsTab" closable="false">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Habits" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label text="Habit tracking features coming soon" style="-fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- Quotes Tab -->
            <Tab text="💬 Quotes" fx:id="quotesTab" closable="false">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Quotes" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label text="Quote features coming soon" style="-fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- Analytics Tab -->
            <Tab text="📈 Analytics" fx:id="analyticsTab" closable="false">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Analytics" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label text="Analytics features coming soon" style="-fx-font-size: 12;"/>
                </VBox>
            </Tab>

            <!-- Reminders Tab -->
            <Tab text="🔔 Reminders" fx:id="remindersTab" closable="false">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Reminders" style="-fx-font-size: 14; -fx-font-weight: bold;"/>
                    <Label text="Reminder features coming soon" style="-fx-font-size: 12;"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 10;" spacing="10">
            <Label fx:id="statusLabel" text="Ready"
                   style="-fx-text-fill: #34495e;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dateTimeLabel" text="Loading..."
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 10;"/>
        </HBox>
    </bottom>

</BorderPane>
